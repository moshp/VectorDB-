__pycache__/
*.pyc

# Llama model (2 GB); downloaded automatically on first run
models/

# Databases, uploads and logs built at run time; the PDFs, their source list,
# the test questions and the topic names are kept
data/*
!data/pdfs/
!data/manifest.json
!data/eval_questions.json
!data/topic_names.json

# Generated outputs; the written evaluation reports are kept
reports/*
!reports/*.md
